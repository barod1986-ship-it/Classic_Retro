{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classic-retro.dev/schemas/target-translations.schema.json",
  "title": "Classic Retro Target Translations",
  "description": "The Arabic text of one localization target, by stable id, in the target's notation. A committed file holds no text of the game; a workspace written by 'classic-retro targets extract' adds each original (source) from the user's own copy and stays local.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "language",
    "notation",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "ar"
    },
    "notation": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "text"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "notice"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
