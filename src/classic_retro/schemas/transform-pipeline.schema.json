{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classic-retro.dev/schemas/transform-pipeline.schema.json",
  "title": "Classic Retro Resource Transform Pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codec"
        ],
        "properties": {
          "codec": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object"
          }
        }
      }
    }
  }
}
