{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classic-retro.dev/schemas/game-identity.schema.json",
  "title": "Classic Retro Game Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "title", "media"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "title": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "files"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "size", "sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 1},
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
