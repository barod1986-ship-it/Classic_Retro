{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classic-retro.dev/schemas/rebuild-plan.schema.json",
  "title": "Classic Retro Binary Rebuild Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "safe_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safeRegion"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "alignment": {
          "type": "integer",
          "minimum": 1
        },
        "allow_in_place": {
          "type": "boolean"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "offset",
        "target_resource_id",
        "integer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "target_resource_id": {
          "type": "string",
          "minLength": 1
        },
        "integer": {
          "$ref": "#/$defs/integerReference"
        }
      }
    },
    "integerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_bytes",
        "byte_order"
      ],
      "properties": {
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "byte_order": {
          "type": "string",
          "enum": [
            "little",
            "big"
          ]
        },
        "signed": {
          "type": "boolean"
        },
        "scale": {
          "type": "integer",
          "minimum": 1
        },
        "base_kind": {
          "type": "string",
          "enum": [
            "zero",
            "constant",
            "site"
          ]
        },
        "base_value": {
          "type": "integer"
        },
        "addend": {
          "type": "integer"
        }
      }
    },
    "safeRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "expected_fill_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
