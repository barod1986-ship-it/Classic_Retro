{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classic-retro.dev/schemas/font-profile.schema.json",
  "title": "Classic Retro Font Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "line_height_px",
    "glyphs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "line_height_px": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "glyphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sequence",
          "advance_px"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "string",
            "minLength": 1
          },
          "advance_px": {
            "type": "integer",
            "minimum": 0
          },
          "ink_width_px": {
            "type": "integer",
            "minimum": 0
          },
          "ink_height_px": {
            "type": "integer",
            "minimum": 0
          },
          "offset_x_px": {
            "type": "integer"
          },
          "offset_y_px": {
            "type": "integer"
          }
        }
      }
    }
  }
}
